# Docker Compose settings. Copy this file to .env only when overriding defaults.
POSTGRES_DB=credit_lens_backend
POSTGRES_USER=credit_lens
POSTGRES_PASSWORD=credit_lens
POSTGRES_PORT=5432
WIREMOCK_PORT=8081

MONITORING_POSTGRES_DB=credit_lens_monitoring
MONITORING_POSTGRES_USER=credit_lens_monitoring
MONITORING_POSTGRES_PASSWORD=credit_lens_monitoring
MONITORING_POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

PCR_BASE_URL=http://localhost:8081
PCR_TARGET_ENVIRONMENT=Test
PCR_OWNER_ID_CODE_TYPE=BusinessId
PCR_OWNER_ID_CODE=1234567-8
PCR_OWNER_COUNTRY_CODE=FI
PCR_CONNECT_TIMEOUT=2s
PCR_READ_TIMEOUT=5s

# Monitoring service. The monitoring database credentials intentionally differ
# from the backend database credentials.
BACKEND_BASE_URL=http://localhost:8080
BACKEND_CONNECT_TIMEOUT=2s
BACKEND_READ_TIMEOUT=5s
MONITORING_DB_URL=jdbc:postgresql://localhost:5433/credit_lens_monitoring
MONITORING_DB_USER=credit_lens_monitoring
MONITORING_DB_PASSWORD=credit_lens_monitoring
MONITORING_CRON=0 */5 * * * *
MONITORING_INITIAL_LOOKBACK=PT5M
# Override this recipient only in local or test environments.
MONITORING_RECIPIENT=pcr_monitoring@dansketest.dk

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_ENABLED=false
SMTP_STARTTLS_ENABLED=false
SMTP_SENDER=credit-lens-monitoring@localhost
SMTP_CONNECT_TIMEOUT=2000
SMTP_READ_TIMEOUT=5000

# Optional real-mail profile. By default monitoring uses local Mailpit.
# Start with SPRING_PROFILES_ACTIVE=real-mail to use these settings.
# MONITORING_RECIPIENT=your.email@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your.smtp.username
# SMTP_PASSWORD=your.smtp.password
# SMTP_AUTH_ENABLED=true
# SMTP_STARTTLS_ENABLED=true
# SMTP_SENDER=monitoring@example.com

# The backend uses the matching defaults from application.properties.
# When changing the values above, also export matching DB_URL, DB_USER and
# DB_PASSWORD before starting the backend.
